# Contact form delivery. Without RESEND_API_KEY the /api/contact route returns
# 503 and the form tells the visitor to email us directly (with their message
# prefilled), so an enquiry is never silently lost.
#
# 1. Create an API key at https://resend.com
# 2. Verify vardanntech.com as a sending domain
# 3. Set CONTACT_FROM_EMAIL to an address on that verified domain
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Vardann Tech Website <website@vardanntech.com>"
